extends RefCounted
## Shared physical and visible heights; footprints and building balance stay fixed.
const WALL_HEIGHT=16.0
const WALL_THICKNESS=5.6
const WALL_CAP_THICKNESS=6.0
const WALL_BASE_THICKNESS=6.0
const GATE_WIDTH=12.0
const GATE_FRAME_DEPTH=3.6
const GATE_OPENING_WIDTH=9.6
const GATE_OPENING_HEIGHT=11.0
const GATE_DOOR_WIDTH=GATE_OPENING_WIDTH
const GATE_DOOR_HEIGHT=GATE_OPENING_HEIGHT
const GATE_DOOR_THICKNESS=.9
const GATE_CLOSED_Y=GATE_DOOR_HEIGHT*.5
const GATE_OPEN_Y=GATE_OPENING_HEIGHT+GATE_CLOSED_Y
# The raised leaf fits behind the masonry header instead of protruding above it.
const GATE_HEIGHT=GATE_OPENING_HEIGHT+GATE_DOOR_HEIGHT
const GATE_PILLAR_WIDTH=(GATE_WIDTH-GATE_OPENING_WIDTH)*.5
const GATE_PILLAR_X=(GATE_WIDTH+GATE_OPENING_WIDTH)*.25
const GATE_HEADER_HEIGHT=GATE_HEIGHT-GATE_OPENING_HEIGHT
const GATE_HEADER_Y=GATE_OPENING_HEIGHT+GATE_HEADER_HEIGHT*.5
const STATUE_HEIGHT=30.0
const PEDESTAL_HEIGHT=2.8
const TOWER_DECK_HEIGHT=20.0
const TOWER_DECK_THICKNESS=.5
const TOWER_DECK_CENTER=TOWER_DECK_HEIGHT-TOWER_DECK_THICKNESS*.5
const TOWER_BODY_HEIGHT=TOWER_DECK_HEIGHT-TOWER_DECK_THICKNESS
const TOWER_LOOKOUT_HEIGHT=25.0
const TOWER_LOOKOUT_THICKNESS=.6
const TOWER_LOOKOUT_CENTER=TOWER_LOOKOUT_HEIGHT-TOWER_LOOKOUT_THICKNESS*.5
const TOWER_HEIGHT=TOWER_LOOKOUT_HEIGHT+.6
const BARRACKS_BODY_HEIGHT=5.4
const BARRACKS_DECK_THICKNESS=.6
const BARRACKS_DECK_HEIGHT=BARRACKS_BODY_HEIGHT+BARRACKS_DECK_THICKNESS
const BARRACKS_DECK_CENTER=BARRACKS_BODY_HEIGHT+BARRACKS_DECK_THICKNESS*.5
const BARRACKS_HEIGHT=BARRACKS_DECK_HEIGHT+2.2
const BOW_LOCAL_GRIP=Vector3(.85,1.25,.6)
# Raised ROM Goemon grip, shared by visible bows and tower arrow targeting.
const TOWER_MUZZLE_OFFSET=Vector3(-.897608,.935814,.352590)
const WORKER_CONTACT_HEIGHT=1.6
const HEIGHTS={"wall":WALL_HEIGHT,"gate":GATE_HEIGHT,"shrine":STATUE_HEIGHT+PEDESTAL_HEIGHT,"tower":TOWER_HEIGHT,"mine":6.0,"barracks":BARRACKS_HEIGHT}
static func height(kind:String)->float:return HEIGHTS.get(kind,4.0)
