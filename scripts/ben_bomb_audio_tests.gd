extends "res://scripts/character_sound_tests.gd"
class FeedbackAudioGame extends AudioGame:
	func impact_effect(_point: Vector3,_direction: Vector3,_strength: int):pass
## Runs the production Game.sound → MoveAudio → SoundLibrary → voice route.
func run():
	DirAccess.make_dir_recursive_absolute(sandbox+"/recordings")
	lib=new_library();game=FeedbackAudioGame.new();root.add_child(game);game.setup_audio()
	game.player=Hero.new();game.player.character_id=1;game.sound_library=lib;lib.game=game
	lib.select_character(15)
	var ticket={"move_audio":{"character_id":15,"move_key":"secondary","voiced":false}}
	game.sound("fire_impact",.6,false,ticket,15)
	var before=game.move_audio.cursor
	game.sound("ben_bomb_explosion",.6,false,ticket,15)
	check(game.last_sound_voice.get_meta("kind","")=="ben_bomb_explosion" and game.last_sound_voice.stream==SoundLibrary.original_for(15,"ben_bomb_explosion"),"Detonation dispatches Ben's single low boom after switching away")
	check(game.last_sound_voice.stream.resource_path.ends_with("/ben/bomb_end.wav") and game.last_sound_voice.stream.get_length()>.7,"Detonation uses the full941boom instead of the remaining tonal940warning")
	var start_order=game.voice_idx
	game.sound("ben_bomb_end",.6,false,ticket,15)
	check(game.voice_idx==start_order+1 and game.last_sound_voice.get_meta("kind","")=="ben_bomb_end" and game.last_sound_voice.stream.resource_path.ends_with("/ben/bomb_end.wav"),"The termination event dispatches original941 through the real voice pool")
	check(game.move_audio.cursor==before and not ticket.move_audio.voiced,"Bomb phase sounds cannot release a cast voice")
	check(is_equal_approx(game.last_sound_voice.pitch_scale,1.0),"Original bomb termination retains its source pitch")
	var take=fixture();check(save("fire_impact",take),"Existing Ben impact recording saves")
	game.sound("ben_bomb_explosion",.6,false,ticket,15)
	check(game.last_sound_voice.stream==lib.custom_for(15,"fire_impact"),"Existing impact recording overrides the detonation")
	var order=game.voice_idx;game.sound("ben_bomb_end",.6,false,ticket,15)
	check(game.voice_idx==order,"A legacy impact recording plays once without an unwanted native termination tail")
	check(save("ben_bomb_end",fixture(22050)),"Ben accepts a separate termination recording")
	game.sound("ben_bomb_end",.6,false,ticket,15)
	check(game.last_sound_voice.stream==lib.custom_for(15,"ben_bomb_end"),"An explicit termination recording can replace941 independently")
	lib.set_muted("fire_impact",true);order=game.voice_idx
	game.sound("ben_bomb_explosion",.6,false,ticket,15);game.sound("ben_bomb_end",.6,false,ticket,15)
	check(game.voice_idx==order,"Existing Ben impact mute suppresses both bomb phases")
	lib.set_muted("fire_impact",false);lib.set_muted("ben_bomb_end",true);order=game.voice_idx
	game.sound("ben_bomb_end",.6,false,ticket,15)
	check(game.voice_idx==order,"Separate termination mute is respected")
	check(SoundLibrary.original_for(14,"ben_bomb_end")==null and SoundLibrary.original_for(1,"ben_bomb_explosion")==null,"Bomb phase defaults remain isolated to Ben")
	lib.set_muted("ben_bomb_end",false);lib.set_gain("fire_impact",.5);lib.set_gain("ben_bomb_end",.8)
	game.sound("ben_bomb_end",.6,false,ticket,15)
	check(is_equal_approx(db_to_linear(game.last_sound_voice.volume_db),.6*.55*.5*.8),"Explicit bomb phases preserve the legacy and phase gains")
	lib.reset_slot("fire_impact");lib.set_gain("fire_impact",.5);lib.set_gain("ben_bomb_explosion",.7)
	game.sound("ben_bomb_explosion",.6,false,ticket,15)
	check(game.last_sound_voice.stream==lib.custom_for(15,"ben_bomb_end"),"A saved terminal-boom recording survives as the sole detonation sound")
	lib.listen(game.sound_preview(15,"ben_bomb_explosion"),"ben_bomb_explosion")
	check(lib.preview.stream==lib.custom_for(15,"ben_bomb_end"),"Studio previews the same promoted boom recording heard in gameplay")
	lib.take=fixture(44100);lib.take_slot="ben_bomb_explosion";lib.listen(lib.take,"ben_bomb_explosion")
	check(lib.preview.stream==lib.take,"An unsaved detonation take can still be auditioned before saving")
	lib.preview.stop();lib.take=null;lib.take_slot=""
	check(is_equal_approx(db_to_linear(game.last_sound_voice.volume_db),.6*.55*.5*.7*.8),"Promoted boom retains legacy impact, detonation and terminal gains")
	lib.set_muted("ben_bomb_end",true);order=game.voice_idx;game.sound("ben_bomb_explosion",.6,false,ticket,15)
	check(game.voice_idx==order,"An existing terminal-boom mute also mutes its promoted detonation")
	check(save("ben_bomb_explosion",fixture()),"An explicit complete detonation take saves")
	game.sound("ben_bomb_explosion",.6,false,ticket,15)
	check(game.last_sound_voice.stream==lib.custom_for(15,"ben_bomb_explosion"),"A complete detonation take owns the event instead of the former tail controls")
	lib.set_muted("ben_bomb_end",false)
	game.sound("ben_polearm_strike_voice",.6,false,ticket,15)
	check(game.last_sound_voice.stream==SoundLibrary.original_for(15,"ben_polearm_strike_voice"),"Polearm follow-through dispatches source A8B")
	check(save("move_primary_1_voice",fixture()),"A custom complete polearm voice saves")
	order=game.voice_idx;game.sound("ben_polearm_strike_voice",.6,false,ticket,15)
	check(game.voice_idx==order,"Custom primary voice is not followed by native A8B or played a second time")
	lib.set_muted("move_primary_1_voice",true);order=game.voice_idx
	game.sound("ben_polearm_strike_voice",.6,false,ticket,15)
	check(game.voice_idx==order,"Primary voice mute also suppresses polearm follow-through")
	lib.set_muted("move_primary_1_voice",false)
	check(save("ben_polearm_strike_voice",fixture(22050)),"An explicit follow-through voice can be recorded")
	game.sound("ben_polearm_strike_voice",.6,false,ticket,15)
	check(game.last_sound_voice.stream==lib.custom_for(15,"ben_polearm_strike_voice"),"Explicit follow-through recording takes precedence")
	game.sound("ben_polearm_finish",.6,false,ticket,15)
	check(game.last_sound_voice.get_meta("kind","")=="ben_polearm_finish" and game.last_sound_voice.stream==SoundLibrary.original_for(15,"heavy_swing"),"Polearm key65 dispatches the original93F finish")
	check(save("move_primary_1_weapon",fixture()),"Custom complete polearm weapon saves")
	order=game.voice_idx
	game.sound("ben_polearm_dash",.6,false,ticket,15);game.sound("ben_polearm_finish",.6,false,ticket,15)
	check(game.voice_idx==order,"Custom complete primary weapon suppresses duplicate native dash and finish phases")
	lib.set_muted("move_primary_1_weapon",true);order=game.voice_idx
	game.sound("ben_polearm_dash",.6,false,ticket,15);game.sound("ben_polearm_finish",.6,false,ticket,15)
	check(game.voice_idx==order,"Primary weapon mute covers native dash and finish phases")
	var victim=Ninja.new();order=game.voice_idx
	game.confirm_ally_impact(victim,Vector3.ZERO,Vector3.UP,2,true,15)
	check(game.voice_idx==order,"Ben bomb feedback cannot layer a placeholder coin impact over original explosion audio")
	victim.free()
	game.sound("throw",.35,false,ticket,15)
	check(game.last_sound_voice.stream==SoundLibrary.original_for(15,"move_secondary_weapon"),"Bomb release resolves to its original943sample rather than the generic menu/spark fallback")
	check(save("move_secondary_weapon",fixture(22050)),"Ben accepts a separate bomb-release recording")
	game.sound("throw",.35,false,ticket,15)
	check(game.last_sound_voice.stream==lib.custom_for(15,"move_secondary_weapon"),"A saved secondary weapon recording replaces the bomb-release sample")
	lib.set_muted("move_secondary_weapon",true);order=game.voice_idx;game.sound("throw",.35,false,ticket,15)
	check(game.voice_idx==order,"Bomb-release mute suppresses the cue without changing explosion audio")
	lib.select_character(14)
	game.sound("ed_assault_burst",.6,false,{},14)
	check(game.last_sound_voice.stream==SoundLibrary.original_for(14,"ed_assault_burst"),"Ed finisher plays recovered981 radial-burst audio")
	check(save("ed_assault_burst",fixture()),"Ed accepts a separate finisher recording")
	game.sound("ed_assault_burst",.6,false,{},14)
	check(game.last_sound_voice.stream==lib.custom_for(14,"ed_assault_burst"),"Ed finisher uses the user's recording instead of the native sample")
	lib.set_muted("ed_assault_burst",true);order=game.voice_idx;game.sound("ed_assault_burst",.6,false,{},14)
	check(game.voice_idx==order,"Ed finisher respects its independent mute")
	for voice in game.voices:voice.stop()
	game.move_audio.stop()
	await create_timer(.3).timeout
	game.player.free();game.player=null;lib.game=null;lib.free();game.sound_library=null;game.free()
	await create_timer(.15).timeout
	remove_sandbox(sandbox)
	print("BEN_BOMB_AUDIO_RESULT checks=",checks," failures=",failures)
	quit(0 if failures==0 else 1)
