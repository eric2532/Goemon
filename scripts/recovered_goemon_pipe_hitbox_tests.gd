extends "res://scripts/recovered_goemon_gameplay_tests.gd"
## Real Hero attacks and physics hurt shapes; target points are on independently
## reconstructed ROM weapon vertices, not generated by the collision resolver.
var raw_motion:Dictionary
func pose_fixture(stage:int,frame_:float):
 var p=game.player
 p.attack_heavy=false;p.combo=stage;p.attack_duration=RecoveredGoemonCombatProfile.duration(stage)
 var elapsed=frame_/18.0
 p.attack_left=p.attack_duration-elapsed
 p.model.rotation.y=0;p.model.pipe_visual_scale=1.15
 p.model.animate(0,0,true,0,p.attack_left/p.attack_duration,false,stage,false);p.model.sync_skeleton()
func raw_pipe_point(stage:int,frame_:int,local:Vector3)->Vector3:
 var action=0x67+stage
 var clip:Dictionary=raw_motion.clips[raw_motion.actions[str(action)]]
 var v:Array=clip.frames[frame_][clip.pointers.find("0x9002518")]
 var native=Transform3D(Basis(Vector3(v[0],v[1],v[2]),Vector3(v[3],v[4],v[5]),Vector3(v[6],v[7],v[8])),Vector3(v[9],v[10],v[11]))
 var model=game.player.model
 var visual_factor=model.pipe_visual_scale/HeroModel.WeaponProportions.SCALE
 return model.rig_visual.global_transform*((native.basis*local*visual_factor+native.origin)*model.source_scale+model.source_offset)
func target_at(point:Vector3):
 var dummy=game.training_dummy
 dummy.home=point;dummy.position=point
 await physics_frame;await physics_frame
func reset_strike(stage:int=1):
 fresh();game.player.select_weapon(1);game.player.start_attack(false,stage)
 game.player.melee_assist.reset();game.player.facing=Vector3.FORWARD;game.player.position=ORIGIN-Vector3.UP*.1
func run():
 await setup_fixture()
 raw_motion=JSON.parse_string(FileAccess.get_file_as_string("res://assets/characters/recovered_goemon/motion.json"))
 var p=game.player;var dummy=game.training_dummy
 var shape:CollisionShape3D=dummy.get_children().filter(func(c):return c is CollisionShape3D)[0]
 shape.shape.radius=.08;shape.shape.height=.16;shape.position=Vector3.ZERO;dummy.contact_shape.center=Vector3.ZERO
 # A real mesh-tip target at the fully expanded first strike is beyond the old cone.
 reset_strike();pose_fixture(1,4)
 var tip=raw_pipe_point(1,4,Vector3(23,-3,78))
 await target_at(tip)
 p.strike()
 check(contacts==[1],"Expanded Gold Pipe damages a tiny target touching its farthest tip")
 p.strike()
 check(contacts==[1],"The same enemy is damaged only once per pipe strike")
 # The old range fan accepts this point although no part of the weapon is nearby.
 reset_strike();pose_fixture(1,3)
 await target_at(p.global_position+Vector3(0,1.2,-1.0))
 p.strike()
 check(contacts.is_empty(),"A nearby target outside the visible pipe is not hit by the old range fan")
 # End-cap contact at each distinct original strike, with original full scale.
 for stage in [2,3]:
  reset_strike(stage);var frame_=5 if stage==2 else 7;pose_fixture(stage,frame_)
  await target_at(raw_pipe_point(stage,frame_,Vector3(23,-3,78)))
  p.strike()
  check(contacts==[stage],"Stage %d reaches its animated Gold Pipe end cap"%stage)
 # A wall between the wielder and tip still blocks damage.
 reset_strike();pose_fixture(1,4);tip=raw_pipe_point(1,4,Vector3(23,-3,78));await target_at(tip)
 var wall=StaticBody3D.new();wall.collision_layer=1;var blocker=CollisionShape3D.new();var box=BoxShape3D.new();box.size=Vector3(2,8,.18);blocker.shape=box;wall.add_child(blocker);game.add_child(wall)
 var origin=p.global_position+Vector3.UP*1.1;wall.position=origin.lerp(tip,.5);wall.look_at(tip)
 await physics_frame;await physics_frame;p.strike()
 check(contacts.is_empty(),"Gold Pipe cannot damage a target through solid cover")
 wall.queue_free();await physics_frame
 # Normal clock progression must continue checking after the original sound cue.
 reset_strike();pose_fixture(1,4);tip=raw_pipe_point(1,4,Vector3(23,-3,78))
 await target_at(tip);p.attack_left=p.attack_duration;p.hit_done=false
 for i in 18:
  p._physics_process(1.0/60.0);p.position=ORIGIN-Vector3.UP*.1;p.velocity=Vector3.ZERO
  await physics_frame
 check(contacts.has(1),"Actual attack ticks hit a tip target reached after the contact cue as the pipe grows")
 # A large tick must sweep the intervening native poses rather than skip contact.
 reset_strike();pose_fixture(1,3);var middle=raw_pipe_point(1,3,Vector3(23,-3,78))
 await target_at(middle);p.attack_left=p.attack_duration;p.hit_done=false
 p._physics_process(.23)
 check(contacts.has(1),"A large attack tick detects the swept Gold Pipe path between animation samples")
 # Player growth, reach settings and mid-air body turns also move the visible tip.
 reset_strike();p.scale=Vector3.ONE*1.8;pose_fixture(1,4);p.model.pipe_visual_scale=HeroModel.WeaponProportions.SCALE*1.5
 p.model.animate(0,0,true,0,p.attack_left/p.attack_duration,false,1,false);p.model.sync_skeleton()
 await target_at(raw_pipe_point(1,4,Vector3(23,-3,78)));p.strike()
 check(contacts==[1],"Growth and increased visual pipe reach preserve contact at the farthest tip")
 p.scale=Vector3.ONE
 reset_strike();pose_fixture(1,4);p.model.body.rotation.x=-PI*.6;p.model.body.position.y=5
 await target_at(raw_pipe_point(1,4,Vector3(23,-3,78)));p.strike()
 check(contacts==[1],"A turning airborne body carries its actual Gold Pipe hitbox with it")
 reset_strike(3);pose_fixture(3,7);await target_at(raw_pipe_point(3,7,Vector3(23,-3,78)))
 var end=RecoveredGoemonCombatProfile.action_duration(0x6A)
 p.original_pipe_combat.tick(end+.01,end+.05)
 check(contacts.is_empty(),"Recovery after the third swing cannot damage a new target")
 game.move_audio.stop()
 for voice in game.voices:voice.stop()
 game.queue_free();paused=false;await frames();await create_timer(.15).timeout
 if FileAccess.file_exists(cfg):DirAccess.remove_absolute(ProjectSettings.globalize_path(cfg))
 print("GOEMON_PIPE_HITBOX_RESULT checks=%d failures=%d"%[checks,failures]);quit(1 if failures else 0)
