extends "res://scripts/recovered_sasuke_combat_tests.gd"
## Catches wrong native kit routing, skipped swept contacts, cover and stale ownership.
func run():
 for action in ["light_attack","heavy_attack","equip","sky_strike","surge","sprint"]:
  if not InputMap.has_action(action):InputMap.add_action(action)
 for path in ["recovered_yae_combat.gd","recovered_yae_projectile.gd","recovered_yae_combat_profile.gd"]:
  check(ResourceLoader.exists("res://scripts/"+path),"Yae native implementation exists: "+path)
 if failures:quit(1);return
 Profile=load("res://scripts/recovered_yae_combat_profile.gd");Combat=load("res://scripts/recovered_yae_combat.gd");Projectile=load("res://scripts/recovered_yae_projectile.gd")
 arena=Arena.new();root.add_child(arena)
 caster=Caster.new();caster.character_id=17;caster.game=arena;arena.player=caster;arena.add_child(caster)
 var combat=Combat.new();combat.hero=caster;combat.game=arena;caster.add_child(combat);combat.active=true
 combat.input(key("equip",true));check(combat.action_id==0x9f and not combat.blocks_projectile(Vector3.FORWARD),"Shield raises through its original entry before blocking")
 combat.tick(7.0/30.0);check(not combat.blocks_projectile(Vector3.FORWARD),"Shield entry keeps native eight-tick startup")
 combat.tick(1.0/30.0);check(combat.action_id==0xa0 and combat.blocks_projectile(Vector3.FORWARD) and not combat.protects_player(),"Held Sword Shield deflects projectiles without granting melee invulnerability")
 arena.sounds.clear();combat.tick(.1)
 check(arena.sounds==[["yae_shield",17]],"Held spin uses the named Sword Shield weapon slot at native three-tick cadence")
 check(combat.ground_attack_velocity()==Vector3.ZERO,"Shield holds Yae stationary")
 combat.release_input(key("equip",false));check(combat.action_id==0xa1 and not combat.blocks_projectile(Vector3.FORWARD),"Shield release immediately stops deflection and plays native exit")
 combat.cancel();combat.input(key("heavy_attack",true));combat.tick(.2);combat.release_input(key("heavy_attack",false))
 check(combat.mode=="bazooka" and combat.action_id==0xa5,"Early RMB release selects native aerial bazooka")
 combat.tick(1.0/30.0);check(get_nodes_in_group("yae_projectiles").is_empty(),"Aerial bazooka keeps its one-frame source windup")
 combat.tick(1.0/30.0);check(get_nodes_in_group("yae_projectiles").size()==1,"Native aerial frame1 at rate0.6 launches exactly once after two ticks")
 var launched=get_nodes_in_group("yae_projectiles")[0]
 check(launched.velocity==Vector3.ZERO and absf(launched.hit_radius-.454742702)<.00001,"Bazooka launch retains native zero initial motion and30-unit collision radius")
 launched._physics_process(1.0/30.0)
 check(absf(launched.velocity.length()-.454742702)<.00001,"First native missile tick accelerates by one source unit")
 for p in get_nodes_in_group("yae_projectiles"):p.free()
 combat.cancel();combat.input(key("heavy_attack",true));combat.tick(2.1);combat.release_input(key("heavy_attack",false))
 check(combat.mode=="lock_on" and combat.action_id==0xa8,"Fully charged RMB selects native charged bazooka")
 combat.tick(2.0/30.0);check(get_nodes_in_group("yae_projectiles").size()==3,"Native charged bazooka emits three projectiles")
 for p in get_nodes_in_group("yae_projectiles"):p.free()
 arena.sounds.clear();combat.cancel();combat.input(key("heavy_attack",true));combat.tick(.49)
 check(arena.sounds.is_empty(),"Bazooka charge stays silent before native tick15")
 combat.tick(.01);check(arena.sounds==[["yae_bazooka_charge",17]],"Native half-second charge emits event24C once")
 combat.tick(1.0);check(arena.sounds==[["yae_bazooka_charge",17],["yae_bazooka_charge_a",17]],"Held charge emits native24D sustain at1.5seconds")
 combat.tick(.5);check(arena.sounds.size()==2,"Full two-second charge does not play the release weapon early")
 combat.release_input(key("heavy_attack",false));combat.tick(2.0/30.0)
 check(arena.sounds.has(["yae_lock_on",17]) and not arena.sounds.has(["yae_bazooka",17]),"Charged launch routes its own weapon sound slot")
 for projectile in get_nodes_in_group("yae_projectiles"):projectile.free()
 combat.cancel();arena.sounds.clear()
 for facing in [Vector3.FORWARD,Vector3.RIGHT,Vector3.BACK,Vector3.LEFT]:
  combat.cancel();combat.start_bazooka(true);caster.facing=facing;combat.tick(2.0/30.0)
  var native_shots=get_nodes_in_group("yae_projectiles")
  var expect=[]
  if facing==Vector3.FORWARD:expect=[Vector3(.290284693,0,-.956940293),Vector3(.268188089,-.382683396,-.884097517),Vector3(.268188089,.382683396,-.884097517)]
  elif facing==Vector3.RIGHT:expect=[Vector3(.956940293,0,.290284693),Vector3(.884097517,-.382683396,.268188089),Vector3(.884097517,.382683396,.268188089)]
  elif facing==Vector3.BACK:expect=[Vector3(-.290284693,0,.956940293),Vector3(-.268188089,-.382683396,.884097517),Vector3(-.268188089,.382683396,.884097517)]
  else:expect=[Vector3(-.956940293,0,-.290284693),Vector3(-.884097517,-.382683396,-.268188089),Vector3(-.884097517,.382683396,-.268188089)]
  var exact=native_shots.size()==3
  for index in native_shots.size():
   var acceleration:Variant=native_shots[index].get("native_acceleration")
   var actual:Vector3=native_shots[index].velocity.normalized() if acceleration==null else acceleration.normalized()
   exact=exact and actual.distance_to(expect[index])<.00001
  check(exact,"Charged launch preserves native pitch/yaw vectors facing "+str(facing))
  for projectile in native_shots:projectile.free()
 combat.hit();check(combat.action_id==0x1d and not combat.is_attacking(),"Damage cancels charge into native ordinary hit1D")
 combat.tick(10);check(not combat.pose_active(),"Hurt reaction returns to locomotion")
 combat.die();check(combat.action_id==0x2d and combat.pose_active() and not combat.is_attacking(),"Fatal damage retains Yae's native2D death pose")
 combat.cancel();combat.input(key("heavy_attack",true));arena.paused=true;combat.tick(.1)
 check(not combat.is_attacking() and not combat.secondary_held,"Pause discards unfinished bazooka charge")
 arena.paused=false;combat.input(key("equip",true));combat._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
 check(not combat.is_attacking() and not combat.shield_held,"Focus loss clears Sword Shield")
 combat.input(key("sky_strike",true));combat.input(key("surge",true));check(not combat.is_attacking(),"Excluded flute and Mermaid powers have no combat binding")
 arena.sounds.clear();combat.primary_attack();combat.tick(2.0/30.0)
 check(not arena.sounds.has(["yae_katana_1",17]),"Air katana keeps its native source-frame2 windup at rate0.8")
 combat.tick(1.0/30.0);check(arena.sounds.has(["yae_katana_1",17]),"Air katana emits event214 at native tick3")
 combat.finish_attack();combat.primary_attack()
 check(combat.action_id==0x6e and combat.combo==0,"Repeated aerial katana keeps the native air strike and its entry voice group")
 combat.cancel()
 var far=target(Vector3(5,3,0));var near=target(Vector3(2,3,0))
 var p=shot(Vector3(0,3,0),Vector3(100,0,0),"bazooka");p._physics_process(.1)
 check(near.hp<100 and far.hp==100,"Fast bazooka sweeps the nearest fitted target")
 var hp=near.hp;p._physics_process(.1);check(near.hp==hp,"Resolved bazooka deals damage once")
 await process_frame;clear_targets()
 var barrier=wall(Vector3(2,3,0),Vector3(.3,5,6));await physics_frame;await physics_frame
 var covered=target(Vector3(4,3,0));p=shot(Vector3(0,3,0),Vector3(100,0,0),"bazooka");p._physics_process(.1)
 check(covered.hp==100,"World cover blocks bazooka and its blast")
 await process_frame;barrier.free();clear_targets()
 var victim=target(Vector3(1,3,0));p=shot(Vector3(0,3,0),Vector3(20,0,0),"bazooka");p.damage_scale=2;caster.character_id=2;p._physics_process(.1)
 check(victim.hp==16 and victim.received_ticket==p.attack_ticket,"Released bazooka retains source ownership and damage after switching")
 await process_frame;caster.character_id=17;clear_targets()
 var unreachable=target(Vector3(0,1.3,-20));var reachable=target(Vector3(0,1.3,-6))
 combat.input(key("heavy_attack",true));combat.tick(2.1)
 check(combat.lock_targets.size()==1 and combat.lock_targets[0].get_ref()==reachable,"Charge selects only targets reachable within the native missile lifetime")
 combat.cancel();clear_targets()
 var moving=target(Vector3(0,3,-10));p=shot(Vector3(0,3,0),Vector3(0,0,-10),"lock_on");p.target=weakref(moving);moving.position.x=4;p._physics_process(.05)
 check(p.velocity.x>0 and not p.resolved,"Charged missile steers toward its live fitted target")
 p.free();clear_targets()
 var reverse_target=target(Vector3(0,3,10));p=shot(Vector3(0,3,0),Vector3(0,0,-2.7284562),"lock_on")
 p.target=weakref(reverse_target);p.native_acceleration=Vector3.FORWARD*(900*.01515809)
 for tick in 15:p._physics_process(1.0/30.0)
 check(p.velocity.z>0,"Lock-on replaces launch acceleration and reverses toward a target behind the missile")
 p.free();clear_targets()
 caster.model=load("res://scripts/recovered_yae_model.gd").new();caster.add_child(caster.model);caster.model.combat=combat
 combat.cancel();combat.input(key("heavy_attack",true));caster.model.locomotion.grounded=true;caster.model.locomotion.actual_speed=0;caster.model.locomotion.land_age=1;caster.model.locomotion.dirty=true;caster.model.locomotion.evaluate()
 check(caster.model.source_action==0 and not caster.model.native_parts["0x9007bb8"].visible,"Held bazooka charge retains native locomotion rather than playing an unfired bazooka animation")
 combat.release_input(key("heavy_attack",false));caster.model.locomotion.dirty=true;caster.model.locomotion.evaluate()
 check(caster.model.source_action==0xa5 and caster.model.native_parts["0x9007bb8"].visible,"Releasing charge begins the native firing pose with its real bazooka")
 combat.cancel()
 var native_target=target(Vector3(0,1.0,-2.5));combat.primary_attack()
 for frame in 6:combat.tick(1.0/30.0);combat.tick(1.0/30.0,true)
 check(native_target.hp==78,"Native gold katana sphere sweep contacts a real fitted target once")
 clear_targets();native_target=target(Vector3(0,1.0,-2.5));combat.cancel();combat.primary_attack();combat.tick(.03);combat.hit();combat.tick(.03,true)
 check(native_target.hp==100,"Hurt discards queued post-pose sword contact")
 clear_targets();native_target=target(Vector3(5,1.0,-.5));combat.cancel();combat.primary_attack()
 combat.tick(1.0/30.0);caster.model.position.x=10;combat.tick(1.0/30.0,true)
 check(native_target.hp==78,"First post-pose sweep includes the hero's actual movement since attack start")
 caster.model.position.x=0
 arena.free();print("RECOVERED_YAE_COMBAT_RESULT checks=",checks," failures=",failures);quit(1 if failures else 0)
