"],[21,"\tblock"],[23,"\tEndWindow 10000"]],"blocks":[{"line":5,"condition":"Item 18462 >= 1","lines":[[7,"\tEndWindow 11888"]]},{"line":10,"condition":"ItemSpace >= 1","lines":[[12,"\tWindow 11891,YES,NO"],[14,"\tWindow_YES ItemSpace >= 1"],[15,"\tGiveItem 18462,1"],[17,"\tWindow_YES"],[18,"\tWindow_NO"]]},{"line":21,"condition":"","lines":[[23,"\tEndWindow 10000"]]}]},"EV_ijk_6201.txt":{"sha256":"2bde368c427a6e7395f627c4562af60b1ade5f7fca70e0b0dc519ccc73ed423a","lines":[[5,"\tblock Item 18463 >= 1"],[7,"\tEndWindow 11904"],[10,"\tblock ItemSpace >= 1"],[12,"\tWindow 11892,YES,NO"],[14,"\tWindow_YES ItemSpace >= 1"],[15,"\tGiveItem 18463,1"],[17,"\tWindow_YES"],[18,"\tWindow_NO"],[21,"\tblock"],[23,"\tEndWindow 10000"]],"blocks":[{"line":5,"condition":"Item 18463 >= 1","lines":[[7,"\tEndWindow 11904"]]},{"line":10,"condition":"ItemSpace >= 1","lines":[[12,"\tWindow 11892,YES,NO"],[14,"\tWindow_YES ItemSpace >= 1"],[15,"\tGiveItem 18463,1"],[17,"\tWindow_YES"],[18,"\tWindow_NO"]]},{"line":21,"condition":"","lines":[[23,"\tEndWindow 10000"]]}]}},"messages":{"10000":"\n\n你的东西太多了","11876":"\n\n石碑上好像刻有一些古代文字。要看看吗？","11877":"\n扰乱此庙安宁的人将会有大难降临。快离开吧！\n\n　Ⅰ．小庙的守门人在你带着它最喜欢和最讨厌的东西时才会给你通过。\n　Ⅱ．小庙的守门人在你拿着它最喜欢的东西时，会拿走你的东西才给你过。\n　Ⅲ．小庙的守门人在你拿着它最讨厌的东西时，不会拿走你的东西就给你过。","11878":"\n\n在天空中飞翔的　　喜欢肮脏的血讨厌绷带　　地上爬行的　　喜欢绷带讨厌石头\n潜入地底的　　喜欢发亮石讨厌肮脏的血\n\n只有能解此谜的人　　方能进入庙中。","11879":"\n\n叽．叽．．．把那绷带给我．．．\n\n绷带被抢走了。不过可趁机离开这个房间。","11880":"\n\n叽．叽．．．那个石头好可怕．．．\n\n怪物害怕了，可趁机离开这个房间。","11881":"\n\n叽叽叽！！你这小偷．．．不能．给你过．．．","11882":"\n\n叽叽叽！！血．是血啊．．．！\n\n壶被抢走了。不过可趁机离开这个房间。","11883":"\n\n叽～绷带好可怕．．．\n\n怪物害怕了，可趁机离开这个房间。","11884":"\n\n叽叽叽！！呼噜！呼噜！","11885":"\n\n叽叽叽！石头．．．石头！\n\n古代石被抢走了。不过可趁机离开这个房间。","11886":"\n\n叽叽叽！别让我看到血．．．\n\n怪物害怕了，可趁机离开这个房间。","11887":"\n\n叽叽叽！不准过去．．．滚啊．．．","11888":"\n\n调查里面的东西。但是里面已经什么都没有了。","11889":"\n\n里面有个装有红色液体的壶。要拿吗？","11890":"\n\n里面有个肮脏的绷带。要拿吗？","11891":"\n\n里面有个红色的发亮石头。要拿吗？","11892":"\n\n有一堆奇怪的石柱并排在一起。\n地板上放着一张牛皮纸。\n要捡吗？","11902":"\n\n好像还有下文，但是已经看不清楚了。","11903":"\n\n石碑上刻有一些古代文字，但是已经看不清楚了。"