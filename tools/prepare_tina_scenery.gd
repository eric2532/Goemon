extends SceneTree
## Read-only archive sampling; no GPU readback or shared-art changes.
const Art=preload("res://scripts/forest/forest_original_map_art.gd")
const OUTPUT="res://assets/maps/falan/tina/scenery_profiles.gd"
const TREES=[10089,10092,10093]
const PLANTS=[11626,11660,11661,11662,11663,11664,11665,11666,11667,11668,11669,11670,11671,11672,11673,11692,11693,11694,11695,12471,12472,12473,12474,12475,12476,12477,12478,12479,12480,12481,12482,12483,12484,12485]
const POTTED=[16226,16230,16231,16504,16543,17535]
const TABLES=[16560,16561,16562,16566,16567,16569,16573,16574,16575,16576,16577]

func _initialize():
 var records={};var pages={}
 for serial in TREES+PLANTS+POTTED+TABLES:
  var g:Dictionary=Art.data().graphics[str(serial)]
  if not pages.has(g.page):pages[g.page]=Image.load_from_file(Art.ROOT+Art.data().pages[int(g.page)])
  var image:Image=pages[g.page].get_region(Rect2i(g.rect[0],g.rect[1],g.rect[2],g.rect[3]));image.convert(Image.FORMAT_RGBA8)
  var hash_=HashingContext.new();hash_.start(HashingContext.HASH_SHA256);hash_.update(image.get_data())
  var digest=hash_.finish().hex_encode()
  assert(digest==g.rgba_sha256,"Original Tina scenery pixels changed")
  var record={"source_rgba_sha256":digest}
  if serial in TREES:
   var samples=[];var spans={};var bark=[]
   for y in range(int(-g.origin[1]*.72),mini(image.get_height(),-int(g.origin[1])+4)):
    for x in image.get_width():
     var pixel=image.get_pixel(x,y)
     if pixel.a>.99 and pixel.r>pixel.g*1.08 and pixel.g>pixel.b*1.05:bark.append([x,y])
   assert(not bark.is_empty())
   for y in range(0,-int(g.origin[1])-36,3):
    var left=image.get_width();var right=-1
    for x in image.get_width():
     var pixel=image.get_pixel(x,y)
     if pixel.a<.99 or pixel.g<pixel.r*.95 or pixel.g<pixel.b*1.03:continue
     left=mini(left,x);right=maxi(right,x)
     if x%3==0:samples.append([x,y])
    if right>=left:spans[str(y)]=[left,right]
   assert(samples.size()>500)
   record["samples"]=samples;record["spans"]=spans;record["bark"]=bark
  else:
   var mask=BitMap.new();mask.create(image.get_size());var bottom=0
   for y in image.get_height():
    for x in image.get_width():
     var pixel=image.get_pixel(x,y)
     var shadow=is_equal_approx(pixel.r,71.0/255) and pixel.r==pixel.g and pixel.g==pixel.b
     var solid=pixel.a>.8 and not shadow
     mask.set_bit(x,y,solid)
     if solid:bottom=maxi(bottom,y+1)
   mask.grow_mask(1,Rect2i(Vector2i.ZERO,image.get_size()));mask.grow_mask(-1,Rect2i(Vector2i.ZERO,image.get_size()))
   var outlines=[]
   for polygon:PackedVector2Array in mask.opaque_to_polygons(Rect2i(Vector2i.ZERO,image.get_size()),.7):
    if polygon.size()<3 or Geometry2D.triangulate_polygon(polygon).is_empty():continue
    var points=[]
    for pixel in polygon:points.append([pixel.x,pixel.y])
    outlines.append(points)
   assert(not outlines.is_empty())
   record["outlines"]=outlines;record["bottom"]=bottom
   if serial in TABLES:
    # Below the native tabletop diamond, disconnected opaque strips are its actual legs.
    var legs=BitMap.new();legs.create(image.get_size())
    var start=int(image.get_width()*.75)+2
    for y in range(start,image.get_height()):
     for x in image.get_width():legs.set_bit(x,y,mask.get_bit(x,y))
    var feet=[]
    for polygon:PackedVector2Array in legs.opaque_to_polygons(Rect2i(Vector2i.ZERO,image.get_size()),.7):
     var bounds=Rect2(polygon[0],Vector2.ZERO)
     for point:Vector2 in polygon:bounds=bounds.expand(point)
     if bounds.size.y>=3 and bounds.size.x>=2:feet.append([bounds.get_center().x,bounds.end.y-1])
    record["feet"]=feet
  records[str(serial)]=record
 var contents="extends RefCounted\n## Generated by tools/prepare_tina_scenery.gd from preserved original RGBA.\nconst GRAPHICS="+JSON.stringify(records)+"\n"
 if "--check" in OS.get_cmdline_user_args():
  if contents!=FileAccess.get_file_as_string(OUTPUT):printerr("Tina scenery profiles do not reproduce");quit(1);return
 else:
  var file=FileAccess.open(OUTPUT,FileAccess.WRITE);file.store_string(contents)
 print("TINA_SCENERY_PROFILES_RESULT source hashes verified; trees=",TREES.size()," plants=",PLANTS.size()+POTTED.size()," tables=",TABLES.size())
 quit()
