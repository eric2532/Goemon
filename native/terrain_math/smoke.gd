extends SceneTree
func _initialize():
 var status=GDExtensionManager.load_extension("res://native/terrain_math/terrain_math.gdextension")
 assert(status==GDExtensionManager.LOAD_STATUS_OK or status==GDExtensionManager.LOAD_STATUS_ALREADY_LOADED)
 assert(ClassDB.class_exists("GoemonTerrainMath"))
 var native=ClassDB.instantiate("GoemonTerrainMath")
 for method in ["configure_field","set_obstacles","sample","walls_clear"]:assert(native.has_method(method))
 var heights=PackedFloat32Array();heights.resize(161*161);heights.fill(0)
 var covered=PackedByteArray();covered.resize(161*161);covered.fill(1)
 native.configure_field(161,3.0,heights,covered)
 native.set_obstacles(PackedVector2Array(),PackedVector2Array(),PackedVector3Array())
 var points:PackedVector3Array=native.sample(Vector3.ZERO,Vector3(3,0,0),1.0,1.0,false,false)
 assert(points==PackedVector3Array([Vector3(1,0,0),Vector3(2,0,0),Vector3(3,0,0)]))
 assert(native.sample(Vector3.ZERO,Vector3.ZERO,1.0,1.0,false,false).size()==1)
 assert(native.walls_clear(points,1.0))
 native.set_obstacles(PackedVector2Array([Vector2.ZERO]),PackedVector2Array(),PackedVector3Array())
 assert(native.sample(Vector3.ZERO,Vector3(3,0,0),1.0,1.0,false,false).is_empty())
 native.set_obstacles(PackedVector2Array(),PackedVector2Array(),PackedVector3Array([Vector3(1,0,-1),Vector3(2,0,1)]))
 assert(not native.walls_clear(points,1.0))
 assert(native.walls_clear(PackedVector3Array([Vector3(20,0,0)]),1.0))
 native.set_obstacles(PackedVector2Array(),PackedVector2Array([Vector2.ZERO]),PackedVector3Array())
 assert(native.sample(Vector3.ZERO,Vector3.ZERO,0.0,1.0,true,true).size()==1)
 assert(native.sample(Vector3.ZERO,Vector3(6,0,0),0.0,1.0,true,true).is_empty())
 print("GoemonTerrainMath smoke passed: configure_field, set_obstacles, sample, walls_clear")
 quit()
