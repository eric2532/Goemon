extends "res://tests/forest-shrine/unified_equipment_test.gd"

func pick(id:int):
 var cards=game.menu.find_children("*","Button",true,false).filter(func(card):return card.has_meta("fighter_id"))
 check(cards.all(func(card):return card.get_meta("fighter_id") in game.player.RogueRoster.selection_ids()),"Equipment uses the current Cross Gate chooser")
 var matches=cards.filter(func(card):return card.get_meta("fighter_id")==id)
 check(matches.size()==1,"Requested fighter has one chooser card")
 if matches.is_empty():return
 matches[0].grab_focus();await frames();await click(matches[0])

func run():
 DirAccess.make_dir_recursive_absolute(OUT);root.size=Vector2i(1280,800)
 game=load("res://scenes/forest_title.tscn").instantiate();game.settings_path=cfg;root.add_child(game);current_scene=game;await frames(4)
 game.set_process(false);game.set_physics_process(false);game.player.set_physics_process(false);game.army_runtime.set_process(false);game.army_runtime.set_physics_process(false)
 game.begin_arena();game.choose_rogue_character(34);await frames()
 var xp=game.model.team_progression;xp.award_kills(48);game.player.refresh_max_health(true)
 check(game.spend_level_stat("attack"),"Allocate a point before changing character")
 var ranks=xp.stat_ranks.duplicate();var points=xp.stat_points
 game.equipment_hub.show_page("cosmetics");game.equipment_hub.set_cosmetic_color("qi-red");await frames()
 var saved=FileAccess.get_sha256(cfg);var settings=game.settings.duplicate(true)
 await click(game.equipment_hub.party[0])
 check(game.rogue_roster_open and game.roster_from_equipment and not is_instance_valid(game.equipment_hub) and not game.playing and paused,"Main Character opens the chooser from pre-map Equipment")
 await capture("character-picker-from-equipment")
 await pick(37)
 check(is_instance_valid(game.equipment_hub) and game.player.character_id==37 and not game.playing and game.paused and paused,"Picking a fighter returns to pre-map Equipment")
 check(game.equipment_hub.owners[0]==game.equipment_hub.Gear.character_key(37) and game.equipment_hub.stats.name_label.text==game.player.RogueRoster.name_for(37),"Equipment and stat identity refresh for the chosen fighter")
 check(game.model.team_progression==xp and xp.stat_ranks==ranks and xp.stat_points==points,"Character selection preserves run upgrades")
 check(game.settings==settings and FileAccess.get_sha256(cfg)==saved,"Character selection preserves saved gear, cosmetics and loadouts")
 await capture("character-picker-returned-equipment")
 await click(game.equipment_hub.party[1]);await click(game.equipment_hub.party[0])
 check(game.rogue_roster_open,"Main Character opens the chooser while inspecting a pet")
 await click(game.menu.find_child("RogueRosterClose",true,false))
 check(is_instance_valid(game.equipment_hub) and game.player.character_id==37 and not game.playing and not game.roster_from_equipment,"Back cancels to pre-map Equipment without changing fighter")
 game.equipment_hub.enter_map();await frames()
 var model=game.model;var wave=model.wave;var gold=model.gold
 check(game.playing and not game.paused,"The normal Enter Map action still starts play")
 key(KEY_Q);await frames();await click(game.equipment_hub.party[0]);await pick(34)
 check(is_instance_valid(game.equipment_hub) and game.equipment_from_game and not game.equipment_return_pause and game.player.character_id==34 and paused,"In-game character selection returns to Equipment without losing its return state")
 check(game.equipment_hub.enter_button.text=="Return","In-game Equipment keeps Return instead of Enter Map")
 check(game.model==model and model.wave==wave and model.gold==gold and model.team_progression==xp and xp.stat_ranks==ranks,"Changing fighter keeps the live battle, economy and upgrades")
 key(KEY_Q);await frames();check(not is_instance_valid(game.equipment_hub) and not game.paused and not paused,"Q resumes battle after changing character")
 key(KEY_Q);await frames();await click(game.equipment_hub.party[0]);key(KEY_ESCAPE);await frames()
 check(is_instance_valid(game.equipment_hub) and game.player.character_id==34 and paused,"Esc from the chooser returns to in-game Equipment")
 key(KEY_ESCAPE);await frames();check(not game.paused and not paused,"Esc from returned Equipment resumes battle")
 game.show_pause();game.show_equipment_hub(true);await frames();await click(game.equipment_hub.party[0]);await pick(37)
 check(game.equipment_return_pause and game.paused and paused,"Changing fighter from paused Equipment preserves the original pause")
 game.back_from_equipment();await frames();check(game.ordinary_pause and game.paused and paused and not is_instance_valid(game.equipment_hub),"Back returns to the pause menu")
 game.resume();key(KEY_Q);await frames();await click(game.equipment_hub.party[0]);key(KEY_ESCAPE);await frames()
 var nodes=int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT));var resources=int(Performance.get_monitor(Performance.OBJECT_RESOURCE_COUNT))
 for i in 5:
  await click(game.equipment_hub.party[0]);key(KEY_ESCAPE);await frames(6)
 check(int(Performance.get_monitor(Performance.OBJECT_NODE_COUNT))==nodes and int(Performance.get_monitor(Performance.OBJECT_RESOURCE_COUNT))<=resources,"Repeated Equipment/chooser trips retain no controls or resources")
 game.back_from_equipment();await frames()
 game.show_rogue_roster();await frames();await pick(34)
 check(not is_instance_valid(game.equipment_hub) and not game.rogue_roster_open and not game.roster_from_equipment and not game.paused,"The existing direct roster flow still returns to battle")
 game.sound_library.cancel();game.music.stop();game.queue_free();paused=false;await frames(5);DirAccess.remove_absolute(ProjectSettings.globalize_path(cfg))
 print("EQUIPMENT_CHARACTER_PICKER_RESULT checks=%d failures=%d"%[checks,failures]);quit(1 if failures else 0)
