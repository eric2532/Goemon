extends "res://scripts/recovered_goemon_gameplay_tests.gd"
const Gear=preload("res://scripts/forest/equipment.gd")
const Spells=preload("res://scripts/spells/spell_catalog.gd")
const Pets=preload("res://scripts/forest/pet_catalog.gd")
const OUT="res://build/Other Files/Asset Toolkit/Equipment Hub/Skills/"
func picture(stem:String):
 if DisplayServer.get_name()=="headless":return
 await frames(3);RenderingServer.force_draw()
 check(root.get_texture().get_image().save_png(OUT+stem+".png")==OK,"Captured "+stem)
func run():
 create_timer(240).timeout.connect(func():printerr("EQUIPMENT_SKILLS_TIMEOUT");quit(1))
 DirAccess.make_dir_recursive_absolute(OUT);root.size=Vector2i(1280,800)
 game=load("res://scenes/forest_title.tscn").instantiate();game.settings_path=cfg;root.add_child(game);current_scene=game;await frames(3)
 game.set_process(false);game.set_physics_process(false);game.player.set_physics_process(false);game.army_runtime.set_process(false);game.army_runtime.set_physics_process(false)
 game.settings.forest_pet_loadout=[Pets.key(0)];game.save_settings()
 game.begin_arena();game.choose_rogue_character(34);await frames(3)
 var hub=game.equipment_hub;var original=FileAccess.get_sha256(cfg)
 check(hub.skill_buttons.size()==6 and hub.skills_tab.text=="Skills","Fourth inventory tab and six bottom character skill slots exist")
 hub.show_page("skills")
 check(hub.collection.has("skill:kazi/qigong") and hub.collection.has("skill:"+Spells.RECOVERY),"Skills inventory uses the existing equip restrictions")
 check(not hub.collection.has("skill:"+Spells.BEE_FLURRY),"Bee Flurry is listed under Pet Skills")
 game.settings.forest_pet_loadout=[];hub.refresh_party();hub.pet_skills_tab.pressed.emit()
 check(hub.wearer_key==Gear.character_key(34) and hub.collection==["skill:"+Spells.BEE_FLURRY],"Pet Skills is a category the character can browse without a pet")
 hub.party[1].pressed.emit()
 check(hub.page=="pets" and hub.pet_picker.visible,"Add pet in the roster opens the pet picker")
 game.settings.forest_pet_loadout=[Pets.key(0)];hub.refresh_party();hub.select_owner(0);hub.skills_tab.pressed.emit()
 var qi=hub.inventory[hub.collection.find("skill:kazi/qigong")];var qi_data=hub.item_data("skill:kazi/qigong")
 qi.mouse_entered.emit()
 check(qi.tooltip_text.is_empty() and hub.detail.text.is_empty(),"Skill hover leaves the bottom panel unchanged")
 qi.grab_focus()
 check(hub.detail.text.is_empty() and qi.accessibility_name==qi_data.name+"\n"+qi_data.description,"Keyboard focus preserves the preview and accessible description")
 qi.pressed.emit()
 check(hub.detail.text==qi.accessibility_name and hub.spell_draft.is_empty(),"Activating a focused skill selects its description without equipping")
 check(hub.skill_buttons.values().all(func(button):return not button.disabled and button.get_node("GearIcon").texture==null),"Kaz starts with six empty, editable skill slots")
 hub.selected_item="skill:kazi/qigong";hub.equip_selected()
 var key=Gear.Roster.loadout_key(34,game.settings)
 check(hub.spell_draft[key].equip=="kazi/qigong" and game.player.spell_loadout.spell_for(34,"equip")=="kazi/qigong" and FileAccess.get_sha256(cfg)!=original and hub.status.text.is_empty(),"Equipping immediately saves and prepares the skill without an unsaved label")
 check(hub.skill_buttons.equip.get_node("GearIcon").texture==Spells.KAZI_ICONS["kazi/qigong"],"Equipped skill icon follows the inventory choice")
 hub.pet_skills_tab.pressed.emit();hub.skill_buttons.special_6.pressed.emit()
 check(hub.page=="pet_skills" and hub.selected_slot=="special_6","Choosing a skill slot keeps the pet-inspired category open")
 hub.assign_skill(Spells.BEE_FLURRY)
 check(game.player.spell_loadout.spell_for(34,"special_6")==Spells.BEE_FLURRY,"A character can equip Bee Flurry from its category")
 hub.skills_tab.pressed.emit()
 check(hub.selected_slot=="special_6" and hub.wearer_key==Gear.character_key(34),"Switching skill categories preserves the wearer and active slot")
 game.back_from_equipment();await frames(3);game.choose_rogue_character(34);await frames(3);hub=game.equipment_hub;hub.show_page("skills")
 check(hub.spell_draft[key].equip=="kazi/qigong" and game.player.spell_loadout.spell_for(34,"equip")=="kazi/qigong","Back retains equipped skills")
 hub.selected_item="skill:kazi/qigong";hub.equip_selected()
 hub.select_category_slot("skills","surge");hub.selected_item="skill:kazi/fire";hub.equip_selected();hub.unequip()
 check(not hub.spell_draft[key].has("surge") and hub.skill_buttons.surge.get_node("GearIcon").texture==null,"Unequip leaves the skill slot empty")
 hub.select_item(hub.collection.find("skill:kazi/qigong"))
 for dimensions in [Vector2i(1280,800),Vector2i(960,640)]:
  root.size=dimensions;await frames(3)
  for control in hub.skill_buttons.values()+[hub.skills_tab,hub.pet_skills_tab,hub.enter_button]:check(hub.panel.get_global_rect().encloses(control.get_global_rect()),"Skills row and controls fit the window")
  var frame:Panel=hub.panel.get_node("CollectionFrame")
  var border=frame.get_theme_stylebox("panel")
  var inner=frame.get_global_rect().grow_individual(-border.get_margin(SIDE_LEFT)*hub.panel.scale.x,-border.get_margin(SIDE_TOP)*hub.panel.scale.y,-border.get_margin(SIDE_RIGHT)*hub.panel.scale.x,-border.get_margin(SIDE_BOTTOM)*hub.panel.scale.y)
  check(inner.encloses(hub.pet_skills_tab.get_global_rect().grow(3*hub.panel.scale.x)) and not hub.skills_tab.get_global_rect().intersects(hub.pet_skills_tab.get_global_rect()),"Pet Skills stays inside the inset ivory frame with room for focus")
  check(hub.skill_buttons.equip.position.y>=hub.cosmetic_buttons["1"].position.y+hub.cosmetic_buttons["1"].size.y,"Skills sit below cosmetics without overlap")
  await picture("skills-%dx%d"%[dimensions.x,dimensions.y])
 for character in Gear.Roster.CROSSGATE:
  game.player.select_character(character);hub.refresh_party();hub.select_owner(0);hub.show_page("skills")
  check(hub.skill_buttons.values().all(func(button):return not button.disabled),"All six skill slots are editable on every Cross Gate fighter")
  for action in hub.skill_buttons:
   if not hub.skill_buttons[action].get_meta("description").ends_with("Empty"):check(hub.skill_buttons[action].get_node("GearIcon").texture!=null,"Existing character skill has artwork")
 game.player.select_character(37);hub.refresh_party();hub.select_owner(0)
 check(hub.panel.get_children().all(func(node):return not node is Label or node.text!="Shin"),"Shin is named only in the top owner row")
 root.size=Vector2i(1280,800);hub.show_page("skills");await picture("shin-skills-updated")
 hub.show_page("weapons");await picture("shin-weapons-updated")
 game.player.select_character(36);hub.refresh_party();hub.select_owner(0);hub.show_page("weapons")
 hub.selected_item="weapon:unarmed";hub.equip_selected();await picture("plain-fist-weapons")
 game.player.select_character(34);hub.refresh_party();hub.select_owner(1);hub.pet_skills_tab.pressed.emit()
 check(hub.selected_slot=="equip" and hub.skill_buttons.values().filter(func(button):return button.visible).size()==3,"Selecting a pet exposes its existing three skill slots")
 check(hub.wearer_key==Gear.pet_key(Pets.key(0)) and hub.collection==["skill:"+Spells.BEE_FLURRY],"Pet Skills keeps the selected pet and lists the pet-inspired skill")
 hub.skills_tab.pressed.emit()
 check(hub.wearer_key==Gear.pet_key(Pets.key(0)) and hub.collection.has("skill:kazi/fire") and not hub.collection.has("skill:"+Spells.BEE_FLURRY),"Skills keeps the same pet and offers its compatible shared skills")
 hub.selected_item="skill:kazi/fire";hub.equip_selected()
 hub.select_category_slot("skills","surge");hub.selected_item="skill:kazi/fire";hub.equip_selected()
 check(hub.pet_skill_draft[Pets.key(0)]==["kazi/fire","",""],"Pet duplicate skill families remain rejected")
 game.settings.forest_pet_skills[Pets.key(21)]=["kazi/wind","",""];hub.refresh_party()
 check(hub.pet_skill_draft[Pets.key(21)]==["kazi/wind","",""] and hub.pet_skill_draft[Pets.key(0)]==["kazi/fire","",""],"Pet-picker settings merge without losing edited skill drafts")
 hub.selected_item="skill:kazi/ice";hub.equip_selected()
 hub.select_category_slot("pet_skills","sky_strike");hub.assign_skill(Spells.BEE_FLURRY)
 check(hub.skill_buttons.sky_strike.get_node("GearIcon").texture==Spells.KAZI_ICONS[Spells.BEE_FLURRY],"Equipping Bee Flurry uses its five-bee icon in the pet slot")
 await frames(3)
 check(not hub.inventory_scroll.get_v_scroll_bar().visible and hub.inventory_scroll.get_global_rect().encloses(hub.inventory[23].get_global_rect()),"The Pet Skills grid fits its viewport without scrolling through empty rows")
 await picture("pet-skills")
 root.size=Vector2i(960,640);await picture("pet-skills-small");root.size=Vector2i(1280,800)
 hub.select_owner(0)
 check(hub.page=="pet_skills" and hub.skill_buttons.special_6.get_node("GearIcon").texture==Spells.KAZI_ICONS[Spells.BEE_FLURRY],"Changing the wearer preserves the category and restores its own loadout")
 await picture("pet-inspired-character")
 hub.select_owner(1);hub.show_page("skills")
 var previous=game.settings.duplicate(true);var path=game.settings_path;var saved=FileAccess.get_sha256(path)
 game.settings_path="user://missing-skills-folder/settings.cfg";hub.selected_slot="sky_strike";hub.assign_skill("kazi/wind")
 check(is_instance_valid(game.equipment_hub) and game.settings==previous and FileAccess.get_sha256(path)==saved and hub.pet_skill_draft==previous.forest_pet_skills and hub.status.text.contains("previous equipment is unchanged"),"Failed immediate save restores the visible equipment and preserves saved settings")
 game.settings_path=path
 check(not game.save_equipment_loadouts(hub.draft,hub.skill_draft,hub.cosmetic_draft,{}, {key:{"special_7":"kazi/fire"}},{}),"Save boundary rejects an unknown seventh slot")
 hub.enter_map();await frames(3);game.load_settings()
 check(game.settings.spell_loadouts[key].equip=="kazi/qigong" and game.player.spell_loadout.spell_for(34,"equip")=="kazi/qigong","Character choice saves, reloads and reaches the existing skill controller")
 check(game.settings.spell_loadouts[key].special_6==Spells.BEE_FLURRY,"The character's pet-inspired skill also survives reload")
 check(game.settings.forest_pet_skills[Pets.key(0)]==["kazi/fire","kazi/ice",Spells.BEE_FLURRY],"Pet skill draft saves through the existing native skill settings")
 check(game.army_runtime.pet_skills.casters.has(Pets.key(0)),"Pet choices prepare the existing native caster")
 game.player.spell_loadout.number_input(1,true);game.player.spell_loadout.number_input(1,false)
 check(game.player.spell_loadout.current!=null and game.player.spell_loadout.current.spec.id=="kazi/qigong","Key 1 starts the newly equipped Qi skill through the existing cast controller")
 game.queue_free();current_scene=null;paused=false;await frames(4);DirAccess.remove_absolute(ProjectSettings.globalize_path(cfg))
 print("EQUIPMENT_SKILLS_RESULT checks=%d failures=%d"%[checks,failures]);quit(1 if failures else 0)
