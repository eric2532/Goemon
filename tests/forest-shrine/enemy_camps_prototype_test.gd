extends SceneTree
const Model=preload("res://scripts/forest/forest_model.gd")
const Prototype=preload("res://scripts/forest/forest_camp_prototype.gd")
var failures=0
var checks=0
func _initialize():run.call_deferred()
func check(ok:bool,message:String):
	checks+=1
	if not ok:failures+=1;printerr("FAIL: "+message)
func run():
	var layout=Prototype.layout();var original=JSON.stringify(layout)
	check(preload("res://scripts/forest/forest_map_document.gd").validate(layout).is_empty(),"Prototype keeps a valid standalone map layout")
	var m=Model.new();m.reset(42,{},layout,false)
	check(m.enemy_camps_prototype and m.active_enemy_camps()==3 and m.enemy_statue.hp==1200,"Three camps and a final statue initialize")
	m.damage_enemy_objective(0,10000);check(m.active_enemy_camps()==3,"Preparation cannot damage objectives")
	check(m.start_wave() and m.waves.active_cap()==1000,"Prototype begins one continuous assault with a 1,000-enemy cap")
	m.waves.spawn_clock=0;m.waves.tick(60,m.hero_position)
	check(not m.enemies.is_empty() and m.waves.spawn_groups.size()==3 and m.waves.spawn_groups.values().all(func(group):return group.members.size()<=10) and m.waves.pending>0,"Each camp begins its own group of ten from the finite wave queue")
	check(m.enemies.values().all(func(e):return e.has("portal_index")),"Every reinforcement belongs to a camp")
	m.damage_enemy_objective(-1,99999);check(m.enemy_statue.hp==1200,"Statue stays protected while camps remain")
	m.damage_enemy_objective(0,99999);check(m.active_enemy_camps()==2,"Destroying one camp leaves two spawning camps")
	m.enemies.clear();m.waves.spawn_batch()
	check(not m.enemies.is_empty() and m.enemies.values().all(func(e):return e.portal_index!=0),"Destroyed camp stops immediately while other camps continue")
	m.enemies.clear()
	for i in range(999):m.waves.spawn_enemy(0,Vector3(180,0,-180))
	check(m.waves.spawn_batch()==1 and m.enemies.size()==1000,"Only one arrival fits in the final slot")
	check(m.waves.spawn_batch()==0 and m.enemies.size()==1000,"Full cap prevents every spawn in a batch")
	m.enemies.erase(m.enemies.keys().back());m.waves.spawn_clock=0;m.waves.tick(.01,m.hero_position)
	check(m.enemies.size()==1000,"A freed slot permits reinforcements again")
	m.damage_enemy_objective(1,99999);m.damage_enemy_objective(2,99999)
	var alive=m.enemies.size();m.waves.spawn_clock=0;m.waves.tick(.01,m.hero_position)
	check(m.enemies.size()==alive and m.phase=="wave" and m.active_enemy_camps()==0,"Last camp stops arrivals without deleting the living army or ending combat")
	m.enemies.clear();m.waves.tick(.01,m.hero_position)
	check(m.phase=="wave","Clearing enemies alone cannot skip the statue")
	m.damage_enemy_objective(-1,1200);check(m.phase=="victory" and m.enemy_statue.hp==0,"Exposed statue destruction wins")
	check(JSON.stringify(layout)==original,"Playing never mutates the disposable layout")
	m.reset(42,{}, {},false)
	check(not m.enemy_camps_prototype and m.enemy_statue.is_empty() and m.waves.active_cap()==240,"Normal gameplay resets all prototype state and retains its previous cap")
	check(m.start_wave() and m.waves.pending>0,"Normal finite waves remain intact")
	print("ENEMY_CAMPS_RESULT checks=%d failures=%d"%[checks,failures]);quit(1 if failures else 0)
