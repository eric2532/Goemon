extends "res://tests/forest-shrine/stat_allocation_test.gd"
const Skills=preload("res://scripts/spells/skill_balance.gd")
const Evidence="res://build/Other Files/Skill Levels/"

func picture(name_:String):
 if DisplayServer.get_name()=="headless":return
 await frames(3);await RenderingServer.frame_post_draw
 check(root.get_texture().get_image().save_png(Evidence+name_+".png")==OK,"Rendered "+name_)

func run():
 create_timer(180).timeout.connect(func():printerr("SKILL_POINTS_TIMEOUT");quit(1))
 DirAccess.make_dir_recursive_absolute(Evidence)
 root.size=Vector2i(1280,800);root.set_flag(Window.FLAG_NO_FOCUS,true)
 var doc=load("res://scripts/forest/forest_map_document.gd").new();doc.load_wind_meadow()
 await setup_fixture(doc.data)
 game.set_process(false);game.army_runtime.set_process(false);game.army_runtime.set_physics_process(false)
 var p=game.player;var state=game.model.team_progression
 p.select_character(37);fresh();p.model.select_stance(1);state.reset();state.cards_enabled=false
 p.refresh_max_health(true)
 var settings=game.settings.duplicate(true);var saved=FileAccess.get_sha256(game.settings_path)
 check(Skills.level_skills().size()==19,"Existing skill families, Bee Blink Flurry and Meditation accept points")
 check(Skills.level_skills().filter(func(id):return Skills.Levels.family(id)=="qigong").size()==1,"Qi colors share one upgrade entry")
 check(Skills.level_skills().has("shin/counter") and not Skills.level_skills().has("musashi/counter") and Skills.rules_for(p,"musashi/counter").is_empty(),"Cross Gate 反擊 does not replace a legacy skill with the same suffix")
 check(not game.spend_level_skill("shin/sure-strike"),"A closed panel cannot spend points")
 game.award_team_kill(480)
 check(state.level==3 and state.stat_points==2,"Two earned levels grant the existing two shared points")
 toggle_status_fixture();await frames()
 var panel=game.status_panel
 check(game.paused and paused and panel.point_label.text=="2","The allocation panel pauses play and shows the shared balance")
 await click(panel.find_child("SkillsTab",true,false))
 check(panel.skills_content.visible and not panel.stats_content.visible,"A real click opens the Skills tab")
 check(panel.skill_ids.size()==6 and panel.skill_buttons.size()==6 and panel.find_children("*","OptionButton").is_empty(),"The menu shows exactly six slots without a global dropdown")
 check(panel.skill_ids[0]=="shin/sure-strike","Slot 1 matches the active sword skill")
 var ticket=p.attack_chain.make_ticket("shin_sure_strike").duplicate(true)
 check(panel.skill_buttons[0].tooltip_text.contains("1.10×") and panel.skill_buttons[0].tooltip_text.contains("1.20×"),"Current and next-level damage are visible before spending")
 await click(panel.skill_buttons[0])
 check(state.stat_points==1 and Skills.level_for(p,"shin/sure-strike")==2 and panel.point_label.text=="1","A real click spends exactly one point for one skill level")
 check(ticket.skill_level==1 and p.attack_chain.make_ticket("shin_sure_strike").skill_level==2,"A paid upgrade changes new casts while existing tickets retain their level")
 await click(panel.find_child("StatsTab",true,false));await click(panel.buttons.attack)
 check(state.stat_points==0 and state.stat_ranks.attack==1,"Stats spend from the same remaining point")
 await click(panel.find_child("SkillsTab",true,false));panel.skill_buttons[0].pressed.emit()
 check(Skills.level_for(p,"shin/sure-strike")==2 and panel.skill_buttons[0].disabled,"Zero points disables upgrading and stale clicks cannot overspend")
 check(not game.spend_level_skill("bog/cave-bears") and not game.spend_level_skill("unknown/skill"),"Undefined or unknown skills cannot consume points")
 check(game.settings==settings and FileAccess.get_sha256(game.settings_path)==saved,"Purchases do not rewrite saved balance or preferences")
 game.close_status_panel();await frames();game.award_team_kill(10000000);game.show_status_panel();await frames()
 panel=game.status_panel;panel.show_skills(true)
 var before=state.stat_points
 for i in 28:panel.skill_buttons[0].pressed.emit()
 check(Skills.level_for(p,"shin/sure-strike")==30 and state.stat_points==before-28,"Every purchased level costs one point through level 30")
 before=state.stat_points;panel.skill_buttons[0].pressed.emit()
 check(panel.skill_buttons[0].disabled and not game.spend_level_skill("shin/sure-strike") and state.stat_points==before,"Level-30 and stale requests cannot waste points")
 await picture("skill-points-max-level")
 check(not game.spend_level_skill("kazi/fire") and not game.spend_level_skill("shin/counter") and state.stat_points==before,"Inactive skills cannot consume points")
 check(panel.skill_levels[3].text=="Lv 1 → 2" and panel.skill_buttons[3].tooltip_text.contains("5% missing HP") and panel.skill_buttons[3].tooltip_text.contains("6% missing HP"),"Active meditation exposes its current and next-level healing rules")
 check(panel.skill_names[2].text=="Empty" and panel.skill_buttons[2].disabled,"Empty slots remain visible and disabled")
 p.model.select_stance(2);panel.refresh()
 check(panel.skill_ids.slice(0,3)==["shin/double-edge","shin/counter","shin/two-birds"],"Polearm menu follows all three active weapon skills")
 check(not game.spend_level_skill("shin/sure-strike"),"A stale sword purchase is rejected after changing weapon")
 await click(panel.skill_buttons[0])
 check(Skills.level_for(p,"shin/double-edge")==2,"The polearm slot upgrades its own active skill")
 check(p.spell_loadout.equip(p.character_id,"special_5","kazi/qigong"),"Equip Qi in slot 5 through the existing loadout")
 panel.refresh()
 for i in 9:panel.skill_buttons[4].pressed.emit()
 check(Skills.level_for(p,"maze/qigong")==10 and panel.skill_buttons[4].tooltip_text.contains("+10% crit"),"Paid Qi upgrades apply to color variants and expose the critical milestone")
 check(p.spell_loadout.equip(p.character_id,"sky_strike","kazi/fire"),"Equip Fire in slot 3")
 panel.refresh()
 check(panel.skill_ids[2]=="kazi/fire" and not game.spend_level_skill("shin/two-birds"),"An equipped spell replaces its native skill in the menu and purchase validation")
 await picture("skill-points-six-slots")
 root.size=Vector2i(960,640);await frames();await picture("skill-points-six-slots-small")
 check(root.get_visible_rect().encloses(panel.panel.get_global_rect()) and panel.panel.get_global_rect().encloses(panel.skill_buttons[0].get_global_rect()),"Skills and the upgrade button fit the smaller window")
 for fighter in p.RogueRoster.CROSSGATE:
  p.select_character(fighter);panel.refresh()
  var slots=p.spell_loadout.slots_for(fighter)
  check(panel.skill_ids.size()==6 and panel.skill_ids.all(func(id):return id.is_empty() or Skills.all().has(id)),"All six slots resolve valid skills for Cross Gate fighter %d"%fighter)
  for i in mini(6,slots.size()):
   if slots[i].is_empty():check(panel.skill_buttons[i].disabled,"Empty roster slot cannot spend")
 p.select_character(36);p.active_ability.set_weapon(p.RogueRoster.MazeWeapon.KATANA);panel.refresh()
 check(panel.skill_ids[0]=="maze/assassination" and not panel.skill_buttons[0].disabled,"Katana exposes assassination upgrades")
 p.active_ability.set_weapon(p.RogueRoster.MazeWeapon.KUNAI);panel.refresh()
 check(panel.skill_ids[0]=="maze/blade-dance" and panel.skill_buttons[0].disabled,"Kunai displays blade dance with no undefined upgrades")
 p.active_ability.set_weapon(p.RogueRoster.MazeWeapon.FIST);panel.refresh()
 check(panel.skill_ids[0]==Skills.Catalog.MAZE_QI and Skills.level_for(p,panel.skill_ids[0])==10,"Fist slot uses the shared Qi level")
 p.select_character(p.RogueRoster.LANCELOT_ID);panel.refresh()
 check(panel.skill_ids[0]=="lancelot/random-shot" and panel.skill_ids[1]=="lancelot/sure-strike" and panel.skill_ids[4]=="lancelot/barrage-shadows","Archer slots match arrows, empowered shot and shadows")
 Skills.set_level(p,"shin/sure-strike",29);before=state.stat_points
 panel.refresh();panel.skill_buttons[1].pressed.emit()
 check(Skills.level_for(p,"shin/sure-strike")==30 and state.stat_points==before-1,"Native archer alias spends on the same learned skill family")
 p.select_character(34);panel.refresh();await picture("skill-points-six-filled")
 var levels=state.skill_levels.duplicate();var points=state.stat_points
 game.close_status_panel();await frames();p.select_character(37)
 check(state.skill_levels==levels and state.stat_points==points,"Switching Cross Gate fighters retains learned levels and unspent points")
 game.preview_forest_map(doc.data,false,false,true);await frames()
 check(game.model.team_progression==state and state.skill_levels==levels and state.stat_points==points,"Retained-run travel preserves paid skill progress")
 game.start_wave();game.show_status_panel();await frames();game.close_status_panel();await frames(5)
 var nodes=get_node_count();var resources=Performance.get_monitor(Performance.OBJECT_RESOURCE_COUNT)
 for i in 6:
  game.show_status_panel();await frames();game.status_panel.show_skills(true)
  game.close_status_panel();await frames(3)
 check(get_node_count()<=nodes and Performance.get_monitor(Performance.OBJECT_RESOURCE_COUNT)<=resources,"Repeated Stats/Skills panels leave no retained nodes or resources")
 game.preview_forest_map(doc.data,false,false,false);await frames()
 check(game.model.team_progression.stat_points==0 and game.model.team_progression.skill_levels.is_empty(),"A fresh run clears points and returns every skill to level 1")
 print("SKILL_POINTS_RESULT checks=%d failures=%d"%[checks,failures])
 game.queue_free();paused=false;await frames(4)
 if FileAccess.file_exists(cfg):DirAccess.remove_absolute(ProjectSettings.globalize_path(cfg))
 quit(1 if failures else 0)
