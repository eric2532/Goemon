; Cross Gate — painterly action and defense game
config_version=5

[application]
config/name="Cross Gate"
config/name.painterly_preview="Cross Gate"
config/name.crosshair_aim="Cross Gate"
config/name.fire_siege="Cross Gate"
config/custom_user_dir_name.crosshair_aim="Godot/app_userdata/Goemon Fire Siege Crosshair"
config/custom_user_dir_name.fire_siege="Godot/app_userdata/Goemon Fire Siege"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Azure Ember"
config/icon="res://icon.png"
config/macos_native_icon="res://icon.icns"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/description="Forest Shrine: build and repair defenses in Wind Meadow Valley, fight with the playable roster, and lead native armies against four enemy strongholds with painterly scenery."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[editor]
run/main_run_args="--forest-title --painterly-preview"

[filesystem]
; Editable Blender sources are built explicitly into runtime GLBs by tools/.
import/blender/enabled=false

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
rendering_device/driver.macos="metal"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2

environment/defaults/default_clear_color=Color(0.35, 0.72, 0.86, 1)

[audio]
driver/enable_input=true
default_bus_layout="res://default_bus_layout.tres"
