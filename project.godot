; Goemon — original procedural Godot vertical slice
config_version=5

[application]
config/name="Goemon"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Azure Ember"
config/icon="res://icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/description="Survive ten minutes of growing enemy swarms in Tidefall Sanctuary."

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.macos="metal"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2

environment/defaults/default_clear_color=Color(0.35, 0.72, 0.86, 1)

[audio]
driver/enable_input=true
default_bus_layout="res://default_bus_layout.tres"
